# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local
import_questions.py
extracted-images/
optimized-images/
design-reference/
sip-anki.apkg
*.apkg
anki_import.py

# Python artifacts (remediation scripts)
scripts/__pycache__/
*.pyc

# user PII / outbound email ledgers — LOCAL ONLY, never commit (real user emails + replies)
scripts/*.sent.log
scripts/*.run.log
scripts/replies*.json
scripts/emails.json
scripts/*_emails.json
scripts/outbound_*.json
scripts/founders_*.json
scripts/recovery_*.json
scripts/followups*.json
scripts/*_apr27.json
scripts/obai_*.json
scripts/dhouha_*.json
scripts/hassan_*.json
scripts/fares_*.json
scripts/ai_launch_*.json

# agent run-logs (QUALITY-CONTROL.md §2) — may contain sensitive detail
.agent-logs/

# Large binary source materials — local only, ~530 MB
source-files/

# Extraction/dry-run reports — everything under reports/ is ignored by
# default. If you want a specific subdirectory tracked (e.g. the
# reports/review-2026-04-15/ audit deliverables), force-add the files
# the first time with `git add -f`; git will keep them tracked after
# that regardless of this rule.
reports/
.claude/

# Playwright test artifacts
/tests/e2e/.artifacts/
/tests/e2e/.report/
/playwright-report/
/test-results/
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
ds-dts/

# question-formatting pipeline artifacts
scripts/.format-checkpoint.jsonl
scripts/.format-progress.json
scripts/.format-run.log
scripts/.facts-watch-report.json
