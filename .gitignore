# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local
import_questions.py
extracted-images/
optimized-images/
design-reference/
sip-anki.apkg
*.apkg
anki_import.py

# Python artifacts (remediation scripts)
scripts/__pycache__/
*.pyc

# Large binary source materials — local only, ~530 MB
source-files/

# Extraction/dry-run reports — everything under reports/ is ignored by
# default. If you want a specific subdirectory tracked (e.g. the
# reports/review-2026-04-15/ audit deliverables), force-add the files
# the first time with `git add -f`; git will keep them tracked after
# that regardless of this rule.
reports/
.claude/
